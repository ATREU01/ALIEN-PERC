# CLI RPC (devnet — where ALIEN market is deployed)
SOLANA_RPC_URL=https://api.devnet.solana.com
WALLET_PATH=~/.config/solana/id.json

# ALIEN market setup
ALIEN_MINT=YOUR_ALIEN_TOKEN_MINT_ADDRESS_HERE
ALIEN_ORACLE_FEED=YOUR_PYTH_FEED_ID_64_HEX_CHARS_HERE

# UI Configuration
# Set to your Helius devnet endpoint for best performance:
# VITE_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
VITE_RPC_URL=https://api.devnet.solana.com
VITE_CONTRACT_ADDRESS=YOUR_CA_AFTER_PUMP_FUN_LAUNCH

# Optional overrides
INSURANCE_AMOUNT=1000000000
LP_COLLATERAL=1000000000
